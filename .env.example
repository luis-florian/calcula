# Copy this file to .env.local for local development.
# Do not commit real secrets.

# PostgreSQL connection string for Neon development/local database.
DATABASE_URL=

# Production must use a separate Neon database configured in Vercel production env.
# Do not point local or preview environments at the production database.

# Authentication secret for the future auth provider.
AUTH_SECRET=

# Public values are bundled into browser code at build time.
NEXT_PUBLIC_APP_NAME=Amorta
