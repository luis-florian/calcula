# Copy this file to .env.local for local development.
# Do not commit real secrets.

# PostgreSQL connection string for Neon development/local database.
DATABASE_URL=

# Production must use a separate Neon database configured in Vercel production env.
# Do not point local or preview environments at the production database.

# Authentication secret for Auth.js.
AUTH_SECRET=

# Single allowed user for the credentials login.
AMORTA_LOGIN_USERNAME=
AMORTA_LOGIN_PASSWORD_HASH=

# Stable owner id stored in financing rows.
AMORTA_SINGLE_USER_ID=dev_user

# Local E2E only. Do not configure this in Vercel.
AMORTA_E2E_PASSWORD=

# Public values are bundled into browser code at build time.
NEXT_PUBLIC_APP_NAME=Amorta
